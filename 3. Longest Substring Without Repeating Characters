class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        unordered_set<int>st;
        int count=0;
        int l=0;
        for(int r=0;r<s.size();r++){
           while(st.count(s[r])){
            st.erase(s[l]);
            l++;
           }
           st.insert(s[r]);
           count=max(count,r-l+1);
        }
        return count;
    }
};
time complexity: O(n)
